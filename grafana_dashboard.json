      "id": 1,
      "title": "System Health Arc (Uptime %)",
      "type": "gauge",
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "editorMode": "code",
          "expr": "avg(up) * 100",
          "instant": true,
          "legendFormat": "Cluster Uptime Rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#E63946",
                "value": null
              },
              {
                "color": "#FFB703",
                "value": 50
              },
              {
                "color": "#00F5D4",
                "value": 90
              }
            ]
          }
        }
      },
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
