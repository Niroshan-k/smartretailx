        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 5,
      "title": "AWS CloudWatch Centralized Live Microservice Log Stream",
      "type": "logs",
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch"
          },
          "expression": "fields @timestamp, @message, @logStream | sort @timestamp desc | limit 100",
          "logGroupNames": [
            "/aws/smartretailx/microservices"
          ],
          "queryMode": "Logs",
          "refId": "A",
          "region": "us-east-1"
        }
      ],
      "options": {
        "enableLogDetails": true,
        "showLabels": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 6,
      "title": "Catalog & Inventory Microservices Container Logs",
      "type": "logs",
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch"
          },
          "expression": "fields @timestamp, @message, @logStream | filter @logStream like \"catalog\" or @logStream like \"inventory\" | sort @timestamp desc | limit 50",
          "logGroupNames": [
            "/aws/smartretailx/microservices"
          ],
          "queryMode": "Logs",
          "refId": "A",
          "region": "us-east-1"
        }
      ],
      "options": {
        "enableLogDetails": true,
        "showLabels": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
