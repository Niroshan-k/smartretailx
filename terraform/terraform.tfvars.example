# SmartRetailX AWS Terraform Variables Example Configuration
# Copy this file to terraform.tfvars and fill in your custom settings.
# DO NOT COMMIT terraform.tfvars WITH SENSITIVE SECRETS TO GITHUB!

aws_region               = "us-east-1"
environment              = "production"
vpc_cidr                 = "10.0.0.0/16"
db_instance_class        = "db.t3.micro"
monitoring_instance_type = "t3.micro"
node_instance_types      = ["t3.small"]
